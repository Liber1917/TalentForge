{
  "manifest_version": 3,
  "name": "TalentForge",
  "version": "0.1.0",
  "permissions": ["storage", "alarms", "tabs"],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.bilibili.com/*",
    "*://*.zhihu.com/*",
    "*://*.zhipin.com/*",
    "*://*.shixiseng.com/*",
    "*://*.zhaopin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["dist/content/bilibili.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.zhihu.com/*"],
      "js": ["dist/content/zhihu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["dist/content/boss.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.shixiseng.com/*"],
      "js": ["dist/content/shixiseng.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.zhaopin.com/*"],
      "js": ["dist/content/zhaopin-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.zhaopin.com/*"],
      "js": ["dist/content/zhaopin.js"],
      "run_at": "document_idle"
    }
  ]
}
